# Copy to .env. Values here are local development defaults, not secrets.
PRISM_POSTGRES_HOST=127.0.0.1
PRISM_POSTGRES_PORT=5432
PRISM_POSTGRES_USER=prism
PRISM_POSTGRES_PASSWORD=prism
PRISM_POSTGRES_DB=prism

PRISM_NEO4J_URI=bolt://127.0.0.1:7687
PRISM_NEO4J_USER=neo4j
PRISM_NEO4J_PASSWORD=prism-dev-password

PRISM_REDIS_URL=redis://127.0.0.1:6379/0

# Ollama runs on the host. From inside a container use
# http://host.docker.internal:11434
PRISM_OLLAMA_URL=http://127.0.0.1:11434
# prism-reviewer:v2 is the fine-tuned model (training/README.md says how to build it).
# qwen2.5-coder:3b needs only `ollama pull` and reviews about as well.
PRISM_REVIEWER_MODEL=prism-reviewer:v2

# Stores: "persistent" (Neo4j + pgvector + the index_runs ledger) or "memory".
PRISM_STORE=persistent
PRISM_INDEX_RUN_STALE_AFTER_S=900
PRISM_CALL_CONFIDENCE_THRESHOLD=0.5

# Code embeddings from the host Ollama (ADR 0005).
PRISM_EMBEDDING_MODEL=nomic-embed-text
PRISM_EMBEDDING_BATCH_SIZE=16
PRISM_EMBEDDING_MAX_CHARS=6000

# Review pipeline (Phase 5, ADR 0010). Model calls in flight at once; match OLLAMA_NUM_PARALLEL.
PRISM_MODEL_CONCURRENCY=4
PRISM_REVIEW_MAX_HUNKS=40
PRISM_REVIEW_TIME_LIMIT_S=600
PRISM_REVIEW_MAX_COMMENTS=20
# Verifier (ADR 0011): "handoff" writes requests for a Claude model into the work directory and
# finishes on the next run; "rules" runs the deterministic checks only.
PRISM_VERIFIER=handoff
PRISM_VERIFIER_MIN_CONFIDENCE=0.6
PRISM_REVIEW_WORK_DIR=.prism-work

# Static analysis (ADR 0012). Needs `uv sync --group sast`; PMD also needs Java and a PMD install.
PRISM_SAST_TOOLS=bandit,semgrep,ruff,pmd
PRISM_SEMGREP_CONFIG=p/owasp-top-ten
PRISM_PMD_HOME=
PRISM_SAST_COMMENT_MIN_SEVERITY=medium

# Routing (ADR 0013): security-sensitive and large hunks go to Claude instead of the local model.
PRISM_ESCALATE=true
PRISM_ESCALATE_MIN_LINES=60
